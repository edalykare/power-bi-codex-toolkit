        "Y": {"projections": [{
          "field": {"Measure": {"Expression": {"SourceRef": {"Entity": "Sales"}}, "Property": "Revenue"}},
          "queryRef": "Sales.Revenue",
          "nativeQueryRef": "Revenue"
        }]}
      }
    },
    "drillFilterOtherVisuals": true
  }
}
